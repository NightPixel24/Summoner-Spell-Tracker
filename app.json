{
  "expo": {
    "name": "Summoner Spell Tracker",
    "slug": "summoner-spell-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nightpixel.summonerspelltracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#13233B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#13233B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "backgroundColor": "#0a1320",
    "extra": {
      "eas": {
        "projectId": "4403ad64-1b11-4af4-a0bc-403e92d5be7d"
      }
    },
    "owner": "nightpixel"
  }
}
